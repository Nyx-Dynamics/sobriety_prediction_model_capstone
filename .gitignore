# Data — generated runs are large and reproducible from src/.
# Scoped to run_<timestamp>/ dirs and their "latest" symlinks so the committed
# reference snapshot under data/processed/*/ stays visible (see README).
data/raw/
data/processed/**/run_*/
data/processed/**/latest

# Model artifacts
models/bayesian_trace.nc
models/lstm_checkpoint.pt

# Keep benchmark results
!models/benchmark_results.json

# Outputs — generated runs only; outputs/figures/ holds the committed snapshot.
outputs/run_*/
outputs/latest

